# Build output
build

# Documentation generated by Doxygen
docs

# Example output files
example.output.*

# Test output (use tests/out rather than writing beside a fixture)
tests/out
tests/data/out

# Pycache files
**/__pycache__

# libFuzzer writes its artifacts beside the binary's working directory, which
# is the repository root when a harness is run by hand. A crash or a slow unit
# is a finding to act on, not a file to commit.
/crash-*
/leak-*
/oom-*
/slow-unit-*
/timeout-*

# Deliberately NOT ignored: tests/data/**. The corpus is an input rather than
# output, and this library's corpus is the part that gates the filesystem layer
# of phase F. A blanket `*.txt` or `*.zip` rule here would drop it from every
# clone but this one while `git status` stayed clean - which is exactly how
# regex lost half of what `make check-limits` measures against.
